{
  "name": "metrokit-excel",
  "description": "Excel add-in: xeokit 3D BIM/CAD viewer for XKT, glTF and IFC with NavCube",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "webpack --mode production",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop",
    "start:web": "office-addin-debugging start manifest.xml web",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml && office-addin-manifest validate manifest-content.xml",
    "preview": "webpack serve --mode development"
  },
  "dependencies": {
    "@xeokit/xeokit-sdk": "2.6.114",
    "core-js": "3.38.1",
    "regenerator-runtime": "0.14.1"
  },
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "devDependencies": {
    "@types/office-js": "1.0.438",
    "@types/office-runtime": "1.0.35",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.0",
    "office-addin-cli": "1.6.5",
    "office-addin-debugging": "5.1.6",
    "office-addin-dev-certs": "1.13.5",
    "office-addin-manifest": "1.13.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.1",
    "typescript": "5.5.4",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.1.0"
  }
}
